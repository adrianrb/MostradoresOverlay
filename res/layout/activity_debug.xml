<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFF8F6F4">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/debug_titulo"
            android:textColor="#0D47A1"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/debug_subtitulo"
            android:textColor="#546E7A"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txtTeste"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#607D8B"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnCriarDummy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/btn_criar_dummy" />

        <Button
            android:id="@+id/btnRemoverDummy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_remover_dummy" />

    </LinearLayout>
</ScrollView>
