<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFF8F6F4">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#0D47A1"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/subtitulo"
            android:textColor="#546E7A"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/status_parado"
            android:textColor="#C62828"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtCpuFonte"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/cpu_aguardando"
            android:textColor="#78909C"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnPermissao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/btn_permissao" />

        <Button
            android:id="@+id/btnIniciar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_iniciar" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/label_tamanho"
            android:textColor="#263238"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtTamanho"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#607D8B" />

        <SeekBar
            android:id="@+id/skTamanho"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="40" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_opacidade"
            android:textColor="#263238"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtOpacidade"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#607D8B" />

        <SeekBar
            android:id="@+id/skOpacidade"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="80" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_intervalo"
            android:textColor="#263238"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtIntervalo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#607D8B" />

        <SeekBar
            android:id="@+id/skIntervalo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="11" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/hint"
            android:textColor="#78909C"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnPermissaoArmazenamento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="2. Conceder permissao de armazenamento" />

    </LinearLayout>
</ScrollView>
